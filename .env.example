# Proxy settings
# If you need to use a proxy, uncomment and set the proxy URLs below.
# Example: HTTP_PROXY=http://proxy.example.com:8080
# HTTP_PROXY=
# HTTPS_PROXY=

# APT HTTP pipelining setting (apt-get)
# Set APT_PIPELINING to enable (specifying concurrent connections >= 1) or disable (0).
# Default behavior if left unset depends on whether a proxy is configured:
#   - With proxy configured (HTTP_PROXY or HTTPS_PROXY is set): Disabled (Acquire::http::Pipeline-Depth 0)
#   - Without proxy (neither proxy is set): Enabled (runs with default 10 concurrent connections without setting Acquire::http::Pipeline-Depth)
# APT_PIPELINING=0

# APT No-Cache setting (apt-get)
# Set APT_NO_CACHE to enable (1) or disable (0).
# Default if left unset is APT_NO_CACHE=1 (cache disabled), regardless of proxy settings.
# APT_NO_CACHE=1

# Bind IP address for the Web UI (JupyterLab)
# By default, access is restricted to localhost (127.0.0.1) for security.
# To allow access from other machines on the local network (LAN), set to 0.0.0.0.
# Default if unset: 127.0.0.1
# SNPCASTER_BIND_ADDR=0.0.0.0

# Host port for the Web UI (JupyterLab)
# Set this if you want to change the port on the host machine.
# Default if unset: 59829
# SNPCASTER_PORT=59829
